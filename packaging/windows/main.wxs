<?xml version="1.0" encoding="utf-8"?>
<!-- Built by the release workflow:
     wix build packaging/windows/main.wxs -arch x64 \
         -d Version=<cargo version> -d BinDir=target/release -o <out>.msi

     Note: sdroxide dynamically links SoapySDR.dll; users must install
     PothosSDR (https://downloads.myriadrf.org/builds/PothosSDR/) and put it
     on PATH, which also provides the device driver modules. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
    <Package Name="sdroxide"
             Manufacturer="Josef Jahn"
             Version="$(var.Version)"
             UpgradeCode="25EB3168-CB22-48C3-B5C1-1DE8FCFBEA34"
             Language="1033"
             Compressed="yes"
             Scope="perMachine">

        <!-- Every dev build carries the same version, so without
             AllowSameVersionUpgrades a new dev installer is added beside the
             old one instead of replacing it (AJ3G, 18 Oct 2026). With it, any
             earlier install of the same version is removed first. -->
        <MajorUpgrade AllowSameVersionUpgrades="yes"
                      DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <!-- Used by the Start-menu shortcut below and by the Apps & features /
             Add-Remove Programs entry. Path is relative to the repo root,
             which is where the release workflow runs `wix build`. -->
        <Icon Id="SdroxideIcon" SourceFile="packaging/windows/sdroxide.ico" />
        <Property Id="ARPPRODUCTICON" Value="SdroxideIcon" />
        <Property Id="ARPURLINFOABOUT" Value="https://github.com/dividebysandwich/sdroxide" />

        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="INSTALLFOLDER" Name="sdroxide">
                <Component Id="MainExe" Guid="AE3DD3A4-EB4B-4921-BF67-60089CA6230E">
                    <File Id="SdroxideExe" Source="$(var.BinDir)/sdroxide.exe" KeyPath="yes" />
                </Component>
                <Component Id="LicenseFile" Guid="8D0E1A6B-4C2F-4B7A-9E3D-51A9C7F0B2D4">
                    <File Id="LicenseTxt" Source="LICENSE" Name="LICENSE.txt" KeyPath="yes" />
                </Component>
                <!-- sdroxide.exe embeds the RX-888's Cypress FX3 firmware
                     image, which is MIT licensed rather than GPL like the rest
                     of the binary, so its notice has to be installed too. -->
                <Component Id="Rx888FirmwareLicenseFile" Guid="39C601A1-A18D-4371-A4BE-9C2DA17E18EC">
                    <File Id="Rx888FirmwareLicenseTxt"
                          Source="crates/sdroxide-rx888/firmware/LICENSE.txt"
                          Name="LICENSE-rx888-firmware.txt" KeyPath="yes" />
                </Component>
                <!-- The spoken-announcement voice. CC BY-NC-SA rather than
                     GPL, which is why it is a data file the program reads at
                     run time and not something linked into sdroxide.exe: its
                     notice ships beside it. sdroxide looks for voices in a
                     "voices" directory next to the executable, which is what
                     this installs. -->
                <Component Id="VoiceLicenseFile" Guid="15C8C546-3DCB-4153-B15A-E4F886945ED6">
                    <File Id="VoiceLicenseTxt"
                          Source="assets/voices/LICENSE-voice.txt"
                          Name="LICENSE-voice.txt" KeyPath="yes" />
                </Component>
                <!-- sdroxide.exe embeds CMUdict for grapheme-to-phoneme.
                     BSD-2-Clause, so the notice travels with the binary for
                     the same reason the RX-888 firmware's does. -->
                <Component Id="CmudictLicenseFile" Guid="032C49BD-7CA0-4883-A75C-45B23FC0256E">
                    <File Id="CmudictLicenseTxt"
                          Source="crates/sdroxide-speech/assets/LICENSE-cmudict.txt"
                          Name="LICENSE-cmudict.txt" KeyPath="yes" />
                </Component>
                <Directory Id="VoicesFolder" Name="voices">
                    <Component Id="VoiceModel" Guid="C1052875-84CF-4257-8F03-24280E266EAC">
                        <File Id="VoiceOnnx"
                              Source="assets/voices/en_US-hfc_female-medium.onnx"
                              KeyPath="yes" />
                        <File Id="VoiceOnnxJson"
                              Source="assets/voices/en_US-hfc_female-medium.onnx.json" />
                        <File Id="VoiceModelCard"
                              Source="assets/voices/en_US-hfc_female-medium.MODEL_CARD" />
                    </Component>
                </Directory>
                <Component Id="PathEnv" Guid="603FD0CB-F87B-47EF-98D0-28669884B706">
                    <RegistryValue Root="HKLM" Key="Software\sdroxide" Name="PathEnv" Type="integer" Value="1" KeyPath="yes" />
                    <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="yes" />
                </Component>
            </Directory>
        </StandardDirectory>

        <StandardDirectory Id="ProgramMenuFolder">
            <Component Id="StartMenuShortcut" Guid="E7E821FD-FCFF-4A51-9CEE-22EB5BA5E8C8">
                <Shortcut Id="AppShortcut"
                          Name="sdroxide"
                          Description="Software-defined-radio transceiver"
                          Target="[INSTALLFOLDER]sdroxide.exe"
                          WorkingDirectory="INSTALLFOLDER"
                          Icon="SdroxideIcon" />
                <RegistryValue Root="HKCU" Key="Software\sdroxide" Name="Shortcut" Type="integer" Value="1" KeyPath="yes" />
            </Component>
        </StandardDirectory>

        <StandardDirectory Id="DesktopFolder">
            <Component Id="DesktopShortcut" Guid="9F4B5C21-7A6E-4D38-8C0A-3B1E9D2F6A47">
                <Shortcut Id="DesktopAppShortcut"
                          Name="sdroxide"
                          Description="Software-defined-radio transceiver"
                          Target="[INSTALLFOLDER]sdroxide.exe"
                          WorkingDirectory="INSTALLFOLDER"
                          Icon="SdroxideIcon" />
                <RegistryValue Root="HKCU" Key="Software\sdroxide" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
            </Component>
        </StandardDirectory>

        <Feature Id="Main">
            <ComponentRef Id="MainExe" />
            <ComponentRef Id="LicenseFile" />
            <ComponentRef Id="Rx888FirmwareLicenseFile" />
            <ComponentRef Id="VoiceLicenseFile" />
            <ComponentRef Id="CmudictLicenseFile" />
            <ComponentRef Id="VoiceModel" />
            <ComponentRef Id="PathEnv" />
            <ComponentRef Id="StartMenuShortcut" />
            <ComponentRef Id="DesktopShortcut" />
        </Feature>
    </Package>
</Wix>
