vara-abort = ПРЕРВАТЬ
vara-abort-hint = Разорвать связь немедленно, кто бы ею ни управлял. Другая сторона отвалится по таймауту, а не получит уведомление.
vara-terminal = ТЕРМИНАЛ
vara-callsign = позывной
vara-connect = ПОДКЛЮЧИТЬСЯ
